# LiteLLM Master Key - Required for API authentication
# Generate a secure random key: openssl rand -hex 32
LITELLM_MASTER_KEY=sk-your-secure-master-key

# VertexAI Configuration - Required
VERTEX_PROJECT=your-gcp-project-id
VERTEX_LOCATION=us-central1

# Dashboard Authentication - Required
UI_USERNAME=admin
UI_PASSWORD=your-secure-password-here

# Database URL for usage tracking and dashboard
DATABASE_URL=postgresql://user:pass@/db?host=/cloudsql/project:region:instance

# Optional: Google Application Credentials
# For local testing, point to your service account JSON file
# In Cloud Run, this is handled automatically via the service account
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
